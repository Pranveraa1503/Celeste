/*==================================================
    ROOT
==================================================*/

.root
{
    flex-grow: 1;

    justify-content: center;
    align-items: center;
}

/*==================================================
    BACKGROUND
==================================================*/

.background
{
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    -unity-background-scale-mode: scale-and-crop;
}

/*==================================================
    OVERLAY
==================================================*/

.overlay
{
    position: absolute;

    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    background-color: rgba(0, 0, 0, 0.55);
}

/*==================================================
    CONTENT
==================================================*/

.content
{
    flex-grow: 1;

    justify-content: center;
    align-items: center;

    flex-direction: column;
}

/*==================================================
    LOGO
==================================================*/

.logo-container
{
    align-items: center;

    margin-bottom: 70px;

    opacity: 0;
}

.title
{
    font-size: 72px;

    color: rgb(255, 232, 70);

    -unity-font-style: bold;

    unity-text-align: middle-center;

    margin-bottom: 10px;
}

.subtitle
{
    font-size: 18px;

    color: rgb(210, 210, 210);

    unity-text-align: middle-center;

    opacity: 0.85;
}

/*==================================================
    MENU
==================================================*/

.menu-container
{
    width: 320px;

    align-items: center;
}

.menu-button
{
    width: 280px;

    height: 45px;

    margin-top: 5px;
    margin-bottom: 5px;

    background-color: transparent;

    border-width: 0;

    color: rgb(235, 235, 235);

    font-size: 28px;

    -unity-font-style: bold;

    unity-text-align: middle-center;

    opacity: 0;

    transition-property: color, opacity;
    transition-duration: 0.15s;
}

.menu-button:hover
{
    color: rgb(255, 232, 70);
}

.menu-button:active
{
    color: rgb(255, 190, 60);
}

.menu-button:focus
{
    color: rgb(255, 232, 70);
}

/*==================================================
    FOOTER
==================================================*/

.footer
{
    position: absolute;

    left: 0;
    right: 0;
    bottom: 20px;

    align-items: center;
}

.version
{
    font-size: 14px;

    color: rgba(255, 255, 255, 0.45);

    unity-text-align: middle-center;
}
