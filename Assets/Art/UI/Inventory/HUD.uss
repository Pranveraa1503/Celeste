:root {
    -unity-font: resource("Inter");
    -unity-font-definition: url("project://database/Assets/Art/UI/pixelFont-7-8x14-sproutLands.ttf?fileID=12800000&guid=3baa2a4568d41d145ae492bd01cf8049&type=3#pixelFont-7-8x14-sproutLands");
}

.hud-overlay {
    --color-backdrop: rgba(6, 7, 10, 0.55);
    --color-panel: rgba(18, 20, 27, 0.94);
    --color-panel-alt: rgba(255, 255, 255, 0.04);
    --color-border: rgba(255, 255, 255, 0.08);
    --color-border-strong: rgba(255, 255, 255, 0.16);
    --color-text: rgba(244, 245, 248, 0.94);
    --color-text-dim: rgba(244, 245, 248, 0.55);
    --color-text-faint: rgba(244, 245, 248, 0.32);
    --color-accent: rgb(217, 164, 65);
    --color-accent-soft: rgba(217, 164, 65, 0.16);
    --color-health: rgb(224, 82, 92);
    --color-stamina: rgb(79, 176, 198);
    --color-xp: rgb(143, 111, 214);
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 18px;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-backdrop);
}

.hud-overlay--hidden {
    display: none;
}

.hud-panel {
    width: 720px;
    height: 480px;
    background-color: var(--color-panel);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--color-border-strong);
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
}

.hud-panel {
    width: 85%;        
    height: 90%;       
    max-width: 1400px; 
    max-height: 900px; 
    background-color: var(--color-panel);
    border-radius: var(--radius-lg);
    border-width: 1px;
    border-color: var(--color-border-strong);
    overflow: hidden;
}

.hud-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding-left: 20px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.hud-header__title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 1px;
}

.close-button {
    width: 28px;
    height: 28px;
    padding: 0;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--radius-sm);
    color: var(--color-text-dim);
    font-size: 13px;
    -unity-text-align: middle-center;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.close-button:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: var(--color-text);
}

.tab-bar {
    flex-direction: row;
    height: 52px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    background-color: var(--color-panel-alt);
}

.tab-button {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    color: var(--color-text-dim);
    transition-property: color;
    transition-duration: 0.12s;
}

.tab-button:hover {
    color: var(--color-text);
}

.tab-button--active {
    color: var(--color-accent);
}

.tab-button__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    border-radius: var(--radius-sm);
    background-color: currentColor;
    opacity: 0.85;
}

.tab-button__icon--player {
    background-color: var(--color-health);
}

.tab-button__icon--inventory {
    background-color: var(--color-accent);
}

.tab-button__icon--map {
    background-color: var(--color-stamina);
}

.tab-button__icon--settings {
    background-color: var(--color-xp);
}

.tab-button__label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.tab-indicator {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 25%;
    height: 2px;
    background-color: var(--color-accent);
    transition-property: left;
    transition-duration: 0.18s;
}

.page-container {
    flex-grow: 1;
    position: relative;
}

.page {
    display: none;
    flex-grow: 1;
    padding: 24px;
}

.page--active {
    display: flex;
}

.page__title {
    font-size: 14px;
    color: var(--color-text-dim);
    margin-bottom: 12px;
}

.player-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
}

.player-portrait {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background-color: var(--color-panel-alt);
    border-width: 2px;
    border-color: var(--color-accent);
    margin-right: 14px;
}

.player-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.player-subtitle {
    font-size: 12px;
    color: var(--color-text-dim);
    margin-top: 2px;
}

.stat-bar-group {
    margin-bottom: 24px;
}

.stat-bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.stat-bar-row__label {
    width: 28px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-text-faint);
}

.bar {
    flex-grow: 1;
    height: 16px;
    border-radius: var(--radius-sm);
    background-color: var(--color-panel-alt);
    border-width: 1px;
    border-color: var(--color-border);
    overflow: hidden;
    position: relative;
    justify-content: center;
}

.bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: var(--radius-sm);
    transition-property: width;
    transition-duration: 0.2s;
}

.bar__fill--health {
    background-color: var(--color-health);
}

.bar__fill--stamina {
    background-color: var(--color-stamina);
}

.bar__fill--xp {
    background-color: var(--color-xp);
}

.bar__value {
    -unity-text-align: middle-center;
    font-size: 10px;
    color: var(--color-text);
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-card {
    width: 48%;
    background-color: var(--color-panel-alt);
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--color-border);
    padding: 10px 14px;
    margin-bottom: 10px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.stat-card__label {
    font-size: 12px;
    color: var(--color-text-dim);
}

.stat-card__value {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.inventory-toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
}

.inventory-toolbar__info {
    font-size: 12px;
    color: var(--color-text-dim);
}

.inventory-scroll {
    flex-grow: 1;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.item-slot {
    width: 56px;
    height: 56px;
    margin: 0 6px 6px 0;
    background-color: var(--color-panel-alt);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border);
    transition-property: border-color, background-color;
    transition-duration: 0.12s;
}

.item-slot:hover {
    border-color: var(--color-accent);
}

.item-slot--filled {
    background-color: var(--color-accent-soft);
    border-color: rgba(217, 164, 65, 0.4);
}

.map-frame {
    flex-grow: 1;
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: var(--color-border);
    background-color: var(--color-panel-alt);
    overflow: hidden;
    position: relative;
    margin-bottom: 14px;
}

.map-frame__texture {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(79, 176, 198, 0.06);
}

.map-marker {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    margin-top: -5px;
    border-radius: 5px;
    background-color: var(--color-accent);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.6);
}

.map-frame__compass {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 22px;
    height: 22px;
    border-radius: 11px;
    background-color: rgba(0, 0, 0, 0.4);
    align-items: center;
    justify-content: center;
}

.map-frame__compass-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.map-footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.map-footer__location {
    font-size: 13px;
    color: var(--color-text);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.settings-row__label {
    font-size: 13px;
    color: var(--color-text);
    width: 140px;
}

.settings-slider {
    flex-grow: 1;
    max-width: 300px;
}

.settings-toggle {
    margin: 0;
}

.settings-dropdown {
    flex-grow: 1;
    max-width: 300px;
}

.settings-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.primary-button {
    background-color: var(--color-accent);
    color: rgba(20, 16, 4, 0.92);
    border-width: 0;
    border-radius: var(--radius-sm);
    padding: 8px 18px;
    -unity-font-style: bold;
    font-size: 12px;
    margin-left: 10px;
    transition-property: scale, opacity;
    transition-duration: 0.1s;
}

.primary-button:hover {
    opacity: 0.9;
}

.primary-button:active {
    scale: 0.97 0.97;
}

.ghost-button {
    background-color: transparent;
    color: var(--color-text-dim);
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 8px 18px;
    font-size: 12px;
    margin-left: 10px;
    transition-property: border-color, color;
    transition-duration: 0.12s;
}

.ghost-button:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
}
